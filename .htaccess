<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Missing scripts must return a real 404, never HTML.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/ - [R=404,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Revalidate page shells so deployments cannot mix application versions.
  Header always set Cache-Control "no-cache, no-store, must-revalidate"
  <FilesMatch "\.(js|css)$">
    Header always set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header always set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
